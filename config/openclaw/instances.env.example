# Two OpenClaw host OS processes, one per business agent (design 2026-09-16 §12.2).
# Each block is the environment of ONE process only. Values are examples; the
# secrets stay empty here and are injected by the deployment secret store.
# Names, ports and paths must match config/openclaw/<instance>/host.example.json
# and the BFF's BFF_OPENCLAW_INGRESS_URL / BFF_CRM_OPENCLAW_INGRESS_URL.

# ---- Supply Chain instance (agent main, port 18789) ----------------------
# OPENCLAW_STATE_DIR=C:\openclaw\supply-chain\state
# OPENCLAW_CONFIG_PATH=C:\openclaw\supply-chain\openclaw.json
# OPENCLAW_GATEWAY_TOKEN=            # from EBIZ_SUPPLY_CHAIN_GATEWAY_TOKEN
# EBIZ_SUPPLY_CHAIN_CONNECTOR=       # == BFF_OPENCLAW_CONNECTOR_CREDENTIAL
# EBIZ_SUPPLY_CHAIN_INGRESS=         # == BFF_OPENCLAW_INGRESS_CREDENTIAL
# plugin config: {"enabled": true, "deploymentPath": "C:\openclaw\supply-chain\deployment.json"}

# ---- CRM instance (agent crm, port 18790) ---------------------------------
# OPENCLAW_STATE_DIR=C:\openclaw\crm\state
# OPENCLAW_CONFIG_PATH=C:\openclaw\crm\openclaw.json
# OPENCLAW_GATEWAY_TOKEN=            # from EBIZ_CRM_GATEWAY_TOKEN
# EBIZ_CRM_CONNECTOR=                # == BFF_OPENCLAW_CONNECTOR_CREDENTIAL
# EBIZ_CRM_INGRESS=                  # == BFF_CRM_OPENCLAW_INGRESS_CREDENTIAL
# plugin config: {"enabled": true, "deploymentPath": "C:\openclaw\crm\deployment.json"}

# ---- Shared by both (the sealed host, one Runtime, one tenant) -------------
# host root C:\openclaw\host (sealed build + reviewed visibility patch)
# gatewayOrigin http://127.0.0.1:8000, tenantId, audience, model provider
