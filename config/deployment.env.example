# Deployment configuration and Runtime's independently loaded normal-plugin policy.
EBIZ_DEPLOYMENT_CONFIG=C:\deployment\deployment.json
RUNTIME_PLUGIN_POLICY_PATH=C:\deployment\runtime-plugin-policy.json
APP_PLUGIN_POLICY_PATH=C:\deployment\runtime-plugin-policy.json
BASE_AI_PROVIDER_ATTESTATION_PATH=C:\deployment\base-ai-provider-attestation.json

# Values emitted by the approved artifact attestation/release pipeline.
MCP_PACKAGE_VERSION=
MCP_RECORD_DIGEST=
ERP_PACKAGE_VERSION=
ERP_RECORD_DIGEST=
OPENAI_ADAPTER_PACKAGE_VERSION=
OPENAI_RECORD_DIGEST=
SUPPLY_CHAIN_AGENT_RECORD_DIGEST=
SUPPLY_CHAIN_PLANNING_RECORD_DIGEST=
INVENTORY_CATALOG_RECORD_DIGEST=
COMMERCE_SALES_CATALOG_RECORD_DIGEST=
SUPPLY_CHAIN_WORKFLOW_DIGEST=

# Credential-free endpoints and exact egress hosts.
CREDENTIAL_BROKER_URL=
MCP_ENDPOINT=
MCP_EGRESS_HOST=
OPENAI_ENDPOINT=
OPENAI_EGRESS_HOST=

# Symbolic secret backing variables. Inject values through the deployment secret store.
DEPLOY_BROKER_CLIENT_TOKEN=
DEPLOY_OPENAI_API_KEY=

# Runtime's own mandatory production environment (examples are deliberately empty).
APP_ENV=production
APP_DATABASE_URL=
APP_JWT_SECRET=
CHECKPOINT_DSN=
APP_S3_ENDPOINT_URL=
APP_S3_BUCKET=
APP_S3_REGION=
APP_S3_SUPPORTS_CONDITIONAL_DELETE=true
APP_MODEL_ADAPTER_ID=openai.responses
APP_MODEL_ID=
APP_MODEL_ADAPTER_VERSION=
APP_MODEL_RESPONSE_SCHEMAS_PATH=
APP_CONNECTOR_TARGETS=
APP_CONNECTOR_FIELD_ALLOWLISTS={}

# LOCAL_DEV_E2E validation inputs. Real-dev/UAT stays disabled until the
# reviewed external environment and trusted tenant-bound credential path exist.
SUPPLY_CHAIN_SMOKE_API_URL=http://127.0.0.1:8000
SUPPLY_CHAIN_TENANT_ID=
SUPPLY_CHAIN_CREDENTIAL_REF=
SUPPLY_CHAIN_MARKET_SCOPE=NA_COMPANY
SUPPLY_CHAIN_SKU=
# Governed Runtime EvidenceRef UUID; never a filesystem path.
SUPPLY_CHAIN_SKILL_INPUT_REF=
SUPPLY_CHAIN_SKILL_FILE=
SUPPLY_CHAIN_SKILL_FILE_SHA256=
SUPPLY_CHAIN_SNAPSHOT_TIME=
SUPPLY_CHAIN_EXPECTED_EVIDENCE_COUNT=5
SUPPLY_CHAIN_RUN_ID=
LOCAL_DEV_E2E=true

# Supply Chain Level 2 BFF. Secrets are injected by the deployment secret store.
BFF_POSTGRESQL_URL=
BFF_CURSOR_HMAC_SIGNING_KEY=
BFF_RABBITMQ_URL=
BFF_RUNTIME_URL=http://127.0.0.1:8000
BFF_SUPPLY_CHAIN_SKILL_INPUT_REF=
BFF_LEVEL2_ENABLED=false
BFF_LEVEL2_MQ_ENABLED=false
BFF_MAX_SELECTED_SKUS=10000
BFF_BULK_BATCH_SIZE=200
BFF_TENANT_BULK_CONCURRENCY=2
BFF_GLOBAL_BULK_CONCURRENCY=8
BFF_ETL_WAIT_SECONDS=1800
BFF_ETL_POLL_SECONDS=60

# Deterministic-local fixture publication only. Production and real-dev must
# leave these unset and must not install or attest the fixture wheel.
LOCAL_FIXTURE_PLUGIN_POLICY_PATH=
LOCAL_FIXTURE_CONTRACT_ROOT=
