# Deployment configuration and Runtime's independently loaded normal-plugin policy.
EBIZ_DEPLOYMENT_CONFIG=C:\deployment\deployment.json
RUNTIME_PLUGIN_POLICY_PATH=C:\deployment\runtime-plugin-policy.json
APP_PLUGIN_POLICY_PATH=C:\deployment\runtime-plugin-policy.json
BASE_AI_PROVIDER_ATTESTATION_PATH=C:\deployment\base-ai-provider-attestation.json

# Values emitted by the approved artifact attestation/release pipeline.
MCP_PACKAGE_VERSION=
MCP_RECORD_DIGEST=
ERP_PACKAGE_VERSION=
ERP_RECORD_DIGEST=
OPENAI_ADAPTER_PACKAGE_VERSION=
OPENAI_RECORD_DIGEST=
SUPPLY_CHAIN_AGENT_RECORD_DIGEST=
SUPPLY_CHAIN_PLANNING_RECORD_DIGEST=
INVENTORY_CATALOG_RECORD_DIGEST=
COMMERCE_SALES_CATALOG_RECORD_DIGEST=
SUPPLY_CHAIN_WORKFLOW_DIGEST=
SUPPLY_CHAIN_REGISTRY_GRAPH_DIGEST=
SUPPLY_CHAIN_PUBLICATION_PLAN_DIGEST=

# Credential-free endpoints and exact egress hosts.
CREDENTIAL_BROKER_URL=
MCP_ENDPOINT=
MCP_EGRESS_HOST=
OPENAI_ENDPOINT=
OPENAI_EGRESS_HOST=

# Symbolic secret backing variables. Inject values through the deployment secret store.
DEPLOY_BROKER_CLIENT_TOKEN=
DEPLOY_OPENAI_API_KEY=

# Runtime's own mandatory production environment (examples are deliberately empty).
APP_ENV=production
APP_DATABASE_URL=
APP_JWT_SECRET=
CHECKPOINT_DSN=
APP_S3_ENDPOINT_URL=
APP_S3_BUCKET=
APP_S3_REGION=
APP_S3_SUPPORTS_CONDITIONAL_DELETE=true
APP_MODEL_ADAPTER_ID=openai.responses
APP_MODEL_ID=
APP_MODEL_ADAPTER_VERSION=
APP_MODEL_RESPONSE_SCHEMAS_PATH=
APP_CONNECTOR_TARGETS=
APP_CONNECTOR_FIELD_ALLOWLISTS={}

# LOCAL_DEV_E2E validation inputs. Real-dev/UAT stays disabled until the
# reviewed external environment and trusted tenant-bound credential path exist.
SUPPLY_CHAIN_SMOKE_API_URL=http://127.0.0.1:8000
SUPPLY_CHAIN_TENANT_ID=
SUPPLY_CHAIN_CREDENTIAL_REF=
SUPPLY_CHAIN_MARKET_SCOPE=NA_COMPANY
SUPPLY_CHAIN_SKU=
# Governed Runtime EvidenceRef UUID; never a filesystem path.
SUPPLY_CHAIN_SKILL_INPUT_REF=
SUPPLY_CHAIN_SKILL_FILE=
SUPPLY_CHAIN_SKILL_FILE_SHA256=
SUPPLY_CHAIN_SNAPSHOT_TIME=
SUPPLY_CHAIN_EXPECTED_EVIDENCE_COUNT=5
SUPPLY_CHAIN_RUN_ID=
LOCAL_DEV_E2E=true

# Supply Chain Level 2 BFF. Secrets are injected by the deployment secret store.
BFF_POSTGRESQL_URL=
BFF_CURSOR_HMAC_SIGNING_KEY=
BFF_RABBITMQ_URL=
BFF_RUNTIME_URL=http://127.0.0.1:8000
BFF_SUPPLY_CHAIN_SKILL_INPUT_REF=
BFF_LEGACY_BATCHES_ENABLED=false
BFF_LEVEL2_ENABLED=false
BFF_LEVEL2_MQ_ENABLED=false
BFF_MAX_SELECTED_SKUS=10000
BFF_BULK_BATCH_SIZE=200
BFF_TENANT_BULK_CONCURRENCY=2
BFF_GLOBAL_BULK_CONCURRENCY=8
BFF_ETL_WAIT_SECONDS=1800
BFF_ETL_POLL_SECONDS=60

# Deterministic-local fixture publication only. Production and real-dev must
# leave these unset and must not install or attest the fixture wheel.
LOCAL_FIXTURE_PLUGIN_POLICY_PATH=
LOCAL_FIXTURE_CONTRACT_ROOT=

# OpenClaw reception and Tool Gateway (shared by every profile). These were used
# by the Supply Chain profile before and are listed here because the CRM profile
# reuses them: one BFF connector credential, one Gateway JWT key, one Runtime
# process with one gateway composition.
BFF_OPENCLAW_ENABLED=false
BFF_OPENCLAW_RECEPTION_ENABLED=false
BFF_OPENCLAW_CONNECTOR_CREDENTIAL=
BFF_OPENCLAW_TENANT_ID=
BFF_OPENCLAW_AGENT_ID=main
BFF_OPENCLAW_OFFER_ID=supply-chain-on-demand
BFF_OPENCLAW_INGRESS_URL=http://127.0.0.1:18789/ebiz/tool-gateway/ingress
BFF_OPENCLAW_INGRESS_CREDENTIAL=
TOOL_GATEWAY_JWT_KEY=
TOOL_GATEWAY_JWT_ISSUER=ebizhub-supply-chain-bff
TOOL_GATEWAY_JWT_AUDIENCE=ebizhub-tool-gateway
TOOL_GATEWAY_GENERATION_ID=
TOOL_GATEWAY_CATALOG_REVISION=
SUPPLY_CHAIN_TOOL_GATEWAY_ENABLED=false
SUPPLY_CHAIN_ON_DEMAND_WORKFLOW_DIGEST=
SUPPLY_CHAIN_BFF_INTERNAL_URL=http://127.0.0.1:8001
TOOL_GATEWAY_CID=supply-chain-dev

# CRM profile (OpenClaw x CRM Phase 1, read-only). Off by default. See
# docs/crm-profile.md for the enablement order; every value below is required
# once BFF_CRM_OPENCLAW_ENABLED / CRM_TOOL_GATEWAY_ENABLED are true.
# -- BFF side --
BFF_CRM_OPENCLAW_ENABLED=false
BFF_CRM_OPENCLAW_TENANT_ID=
BFF_CRM_OPENCLAW_AGENT_ID=crm
BFF_CRM_OPENCLAW_OFFER_ID=crm-case-advice
# The CRM OpenClaw host instance's own ingress (a second Adapter process).
BFF_CRM_OPENCLAW_INGRESS_URL=http://127.0.0.1:18790/ebiz/tool-gateway/ingress
BFF_CRM_OPENCLAW_INGRESS_CREDENTIAL=
# crm-service origin for GET /ai/read/v1/crm/session-principal (HTTPS outside loopback).
BFF_CRM_SERVICE_URL=
# -- Runtime / Gateway side --
CRM_TOOL_GATEWAY_ENABLED=false
# The Registry publication checksum printed by tools/publish_crm_advise.py.
CRM_ADVISOR_WORKFLOW_DIGEST=
# Opaque, tenant-bound CRM read-only broker reference (one per tenant, D-2).
CRM_CREDENTIAL_REF=
CRM_TOOL_GATEWAY_CID=crm-advisor
# -- release pins consumed by config/deployment.crm.example.json --
CRM_ADAPTER_RECORD_DIGEST=
CRM_AGENT_RECORD_DIGEST=
CRM_POLICY_VERSION=
