{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ebizhub.example/supply-chain/level2/report-batch-requested.v1.schema.json",
  "title": "Supply Chain report batch requested",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "schema_version", "report_run_id", "batch_id", "selection_snapshot_id", "batch_no", "item_count", "policy_snapshot_ref", "trace_id", "occurred_at"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "schema_version": { "const": 1 },
    "report_run_id": { "type": "string", "format": "uuid" },
    "batch_id": { "type": "string", "format": "uuid" },
    "selection_snapshot_id": { "type": "string", "format": "uuid" },
    "batch_no": { "type": "integer", "minimum": 1, "maximum": 50 },
    "item_count": { "type": "integer", "minimum": 1, "maximum": 200 },
    "policy_snapshot_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
    "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
